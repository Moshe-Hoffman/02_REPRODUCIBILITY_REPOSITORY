.DS_Store
__pycache__/
*.py[cod]
.venv/
venv/
.matplotlib_cache/

# Regenerated study outputs are ignored except for placeholder files. They are
# created locally by each run and should not be mistaken for source inputs.
studies/*/output/*
!studies/*/output/.gitkeep
studies/*/output_si/*

# Repository-wide run summaries are regenerated locally and can contain
# machine-specific paths or timings.
main_results_reproduction_summary.csv
si_reproduction_summary.csv
si_reported_value_checks.csv

# Never add restricted source exports to the public repository.
restricted_data/
raw_private/
